<Window x:Class="QuanLyTruongHoc.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quản lý trường học"
        Height="720"
        Width="1500"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F8">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Background="#1E293B">
            <StackPanel Margin="20">
                <TextBlock Text="QUẢN LÝ"
                           Foreground="White"
                           FontSize="24"
                           FontWeight="Bold"
                           Margin="0 20 0 0"/>

                <TextBlock Text="TRƯỜNG HỌC"
                           Foreground="#38BDF8"
                           FontSize="24"
                           FontWeight="Bold"
                           Margin="0 0 0 35"/>

                <Button x:Name="btnHome" Content="Trang chủ" Height="42" Margin="0 5"/>
                <Button x:Name="btnStudent"
                        Content="Quản lý học sinh"
                        Height="42"
                        Margin="0 5"
                        Click="BtnStudent_Click"/>

                <Button x:Name="btnClass"
                        Content="Quản lý lớp học"
                        Height="42"
                        Margin="0 5"
                        Click="BtnClass_Click"/>
                <Button x:Name="btnStudentClass"
                        Content="Xếp học sinh vào lớp"
                        Height="42"
                        Margin="0 5"
                        Click="BtnStudentClass_Click"/>


                <Button x:Name="btnTeacher"
                        Content="Quản lý giáo viên"
                        Height="42"
                        Margin="0 5"
                        Click="BtnTeacher_Click"/>

                <Button x:Name="btnSubject"
                        Content="Môn học"
                        Height="42"
                        Margin="0 5"
                        Click="BtnSubject_Click"/>

                <Button x:Name="btnAssignment"
                        Content="Phân công giảng dạy"
                        Height="42"
                        Margin="0 5"
                        Click="BtnAssignment_Click"/>

                <Button x:Name="btnAttendance" Content="Điểm danh" Height="42" Margin="0 5" Click="BtnAttendance_Click"/>
                <Button x:Name="btnAttendanceHistory" Content="Lịch sử điểm danh" Height="42" Margin="0 5" Click="BtnAttendanceHistory_Click"/>
                <Button x:Name="btnGrade" Content="Quản lý điểm" Height="42" Margin="0 5" Click="BtnGrade_Click"/>
                <Button x:Name="btnProfile" Content="Xem hồ sơ" Height="42" Margin="0 5" Click="BtnProfile_Click"/>
                <Button x:Name="btnChangePassword" Content="Đổi mật khẩu" Height="42" Margin="0 5"/>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" CornerRadius="14" Padding="25">
                <StackPanel>
                    <TextBlock x:Name="txtWelcome"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#0F172A"
                               Text="Xin chào!"/>

                    <TextBlock x:Name="txtRole"
                               FontSize="16"
                               Foreground="#64748B"
                               Margin="0 8 0 0"
                               Text="Vai trò: Đang tải..."/>
                </StackPanel>
            </Border>

            <Frame x:Name="MainFrame" 
                   Grid.Row="1" 
                   Margin="0 25 0 0" 
                   NavigationUIVisibility="Hidden"/>

        </Grid>
    </Grid>
</Window>