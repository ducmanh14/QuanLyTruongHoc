<Window x:Class="QuanLyTruongHoc.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quản lý trường học"
        Height="720"
        Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F8">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Background="#1E293B">
            <StackPanel Margin="20">
                <TextBlock Text="QUẢN LÝ"
                           Foreground="White"
                           FontSize="24"
                           FontWeight="Bold"
                           Margin="0 20 0 0"/>

                <TextBlock Text="TRƯỜNG HỌC"
                           Foreground="#38BDF8"
                           FontSize="24"
                           FontWeight="Bold"
                           Margin="0 0 0 35"/>

                <Button x:Name="btnHome" Content="Trang chủ" Height="42" Margin="0 5"/>
                <Button x:Name="btnStudent" Content="Quản lý học sinh" Height="42" Margin="0 5"/>
                <Button x:Name="btnClass" Content="Quản lý lớp học" Height="42" Margin="0 5"/>
                <Button x:Name="btnTeacher" Content="Quản lý giáo viên" Height="42" Margin="0 5"/>
                <Button x:Name="btnSubject" Content="Môn học" Height="42" Margin="0 5"/>
                <Button x:Name="btnAssignment" Content="Phân công giảng dạy" Height="42" Margin="0 5"/>
                <Button x:Name="btnAttendance" Content="Điểm danh" Height="42" Margin="0 5"/>
                <Button x:Name="btnGrade" Content="Quản lý điểm" Height="42" Margin="0 5"/>
                <Button x:Name="btnProfile" Content="Xem hồ sơ" Height="42" Margin="0 5"/>
                <Button x:Name="btnChangePassword" Content="Đổi mật khẩu" Height="42" Margin="0 5"/>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Margin="25">
            <StackPanel>
                <Border Background="White" CornerRadius="14" Padding="25">
                    <StackPanel>
                        <TextBlock x:Name="txtWelcome"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"/>

                        <TextBlock x:Name="txtRole"
                                   FontSize="16"
                                   Foreground="#64748B"
                                   Margin="0 8 0 0"/>
                    </StackPanel>
                </Border>

                <WrapPanel Margin="0 25 0 0">
                    <Border Width="250" Height="130" Background="White" CornerRadius="14" Margin="0 0 20 20" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Học sinh" FontSize="18"/>
                            <TextBlock Text="0" FontSize="42" FontWeight="Bold" Foreground="#2563EB"/>
                        </StackPanel>
                    </Border>

                    <Border Width="250" Height="130" Background="White" CornerRadius="14" Margin="0 0 20 20" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Giáo viên" FontSize="18"/>
                            <TextBlock Text="0" FontSize="42" FontWeight="Bold" Foreground="#16A34A"/>
                        </StackPanel>
                    </Border>

                    <Border Width="250" Height="130" Background="White" CornerRadius="14" Margin="0 0 20 20" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Lớp học" FontSize="18"/>
                            <TextBlock Text="0" FontSize="42" FontWeight="Bold" Foreground="#EA580C"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>