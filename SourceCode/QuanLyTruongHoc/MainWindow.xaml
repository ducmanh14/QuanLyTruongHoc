<Window x:Class="QuanLyTruongHoc.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quản lý trường học"
        Height="720"
        Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F8">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- MENU TRÁI -->
        <Border Background="#1E293B">
            <StackPanel Margin="20">
                <TextBlock Text="QUẢN LÝ"
                           Foreground="White"
                           FontSize="24"
                           FontWeight="Bold"
                           Margin="0 20 0 0"/>

                <TextBlock Text="TRƯỜNG HỌC"
                           Foreground="#38BDF8"
                           FontSize="24"
                           FontWeight="Bold"
                           Margin="0 0 0 35"/>

                <Button x:Name="btnHome" Content="Trang chủ" Height="42" Margin="0 5"/>
                <Button x:Name="btnStudent" Content="Quản lý học sinh" Height="42" Margin="0 5"/>

                <Button x:Name="btnClass" Content="Quản lý lớp học" Height="42" Margin="0 5"/>

                <!-- 3 nút đã được thêm sự kiện Click -->
                <Button x:Name="btnTeacher"
                        Content="Quản lý giáo viên"
                        Height="42"
                        Margin="0 5"
                        Click="BtnTeacher_Click"/>

                <Button x:Name="btnSubject"
                        Content="Môn học"
                        Height="42"
                        Margin="0 5"
                        Click="BtnSubject_Click"/>

                <Button x:Name="btnAssignment"
                        Content="Phân công giảng dạy"
                        Height="42"
                        Margin="0 5"
                        Click="BtnAssignment_Click"/>

                <Button x:Name="btnAttendance" Content="Điểm danh" Height="42" Margin="0 5"/>
                <Button x:Name="btnGrade" Content="Quản lý điểm" Height="42" Margin="0 5"/>
                <Button x:Name="btnProfile" Content="Xem hồ sơ" Height="42" Margin="0 5"/>
                <Button x:Name="btnChangePassword" Content="Đổi mật khẩu" Height="42" Margin="0 5"/>
            </StackPanel>
        </Border>

        <!-- NỘI DUNG CHÍNH (BÊN PHẢI) -->
        <Grid Grid.Column="1" Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Dòng 0: Chứa Header -->
                <RowDefinition Height="*"/>
                <!-- Dòng 1: Chứa MainFrame để load các trang -->
            </Grid.RowDefinitions>

            <!-- Header Cố định -->
            <Border Grid.Row="0" Background="White" CornerRadius="14" Padding="25">
                <StackPanel>
                    <TextBlock x:Name="txtWelcome"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#0F172A"
                               Text="Xin chào!"/>

                    <TextBlock x:Name="txtRole"
                               FontSize="16"
                               Foreground="#64748B"
                               Margin="0 8 0 0"
                               Text="Vai trò: Đang tải..."/>
                </StackPanel>
            </Border>

            <!-- Vùng hiển thị nội dung động (Frame) -->
            <!-- NavigationUIVisibility="Hidden" giúp ẩn thanh điều hướng xấu xí mặc định của WPF -->
            <Frame x:Name="MainFrame" 
                   Grid.Row="1" 
                   Margin="0 25 0 0" 
                   NavigationUIVisibility="Hidden"/>

        </Grid>
    </Grid>
</Window>