<Page x:Class="QuanLyTruongHoc.Views.GradeManagementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F4F6F8">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Quản lý điểm"
                   FontSize="28"
                   FontWeight="Bold"/>

        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="20" Margin="0 0 0 20">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="txtHocSinhId" Grid.Column="0" Height="35" Margin="0 0 10 0"/>
                    <TextBox x:Name="txtLopId" Grid.Column="1" Height="35" Margin="0 0 10 0"/>
                    <TextBox x:Name="txtMonHocId" Grid.Column="2" Height="35" Margin="0 0 10 0"/>
                    <TextBox x:Name="txtHocKy" Grid.Column="3" Height="35" Margin="0 0 10 0"/>
                    <TextBox x:Name="txtNamHoc" Grid.Column="4" Height="35"/>
                </Grid>

                <Grid Margin="0 12 0 0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <ComboBox x:Name="cbLoaiDiem" Grid.Column="0" Height="35" Margin="0 0 10 0">
                        <ComboBoxItem Content="mieng"/>
                        <ComboBoxItem Content="15p"/>
                        <ComboBoxItem Content="1t"/>
                        <ComboBoxItem Content="thi"/>
                    </ComboBox>

                    <TextBox x:Name="txtGiaTri" Grid.Column="1" Height="35"/>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0 15 0 0">
                    <Button Content="Thêm" Width="90" Height="35" Background="#2563EB" Foreground="White" Click="BtnAdd_Click"/>
                    <Button Content="Sửa" Width="90" Height="35" Margin="10 0 0 0" Background="#16A34A" Foreground="White" Click="BtnUpdate_Click"/>
                    <Button Content="Xóa" Width="90" Height="35" Margin="10 0 0 0" Background="#DC2626" Foreground="White" Click="BtnDelete_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="White" CornerRadius="12" Padding="20">
            <DataGrid x:Name="dgGrades" AutoGenerateColumns="False" CanUserAddRows="False" SelectionChanged="DgGrades_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                    <DataGridTextColumn Header="Mã HS" Binding="{Binding MaHS}" Width="100"/>
                    <DataGridTextColumn Header="Họ tên" Binding="{Binding HoTen}" Width="180"/>
                    <DataGridTextColumn Header="Lớp" Binding="{Binding TenLop}" Width="100"/>
                    <DataGridTextColumn Header="Môn" Binding="{Binding TenMon}" Width="150"/>
                    <DataGridTextColumn Header="Loại điểm" Binding="{Binding LoaiDiem}" Width="100"/>
                    <DataGridTextColumn Header="Điểm" Binding="{Binding GiaTri}" Width="80"/>
                    <DataGridTextColumn Header="Học kỳ" Binding="{Binding HocKy}" Width="90"/>
                    <DataGridTextColumn Header="Năm học" Binding="{Binding NamHoc}" Width="110"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Page>