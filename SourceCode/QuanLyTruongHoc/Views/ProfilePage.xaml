<Page x:Class="QuanLyTruongHoc.Views.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F4F6F8">

    <Grid Margin="25">
        <Border Background="White" CornerRadius="12" Padding="30" Width="500" HorizontalAlignment="Left" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="Hồ sơ cá nhân"
                           FontSize="28"
                           FontWeight="Bold"
                           Margin="0 0 0 25"/>

                <TextBlock x:Name="txtHoTen" FontSize="18" Margin="0 0 0 10"/>
                <TextBlock x:Name="txtEmail" FontSize="18" Margin="0 0 0 10"/>
                <TextBlock x:Name="txtVaiTro" FontSize="18" Margin="0 0 0 10"/>
                <TextBlock x:Name="txtMa" FontSize="18" Margin="0 0 0 10"/>
                <TextBlock x:Name="txtThongTinThem" FontSize="18"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
