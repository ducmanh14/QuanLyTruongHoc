<Page x:Class="QuanLyTruongHoc.Views.AttendancePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F4F6F8">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Điểm danh thủ công"
                   FontSize="28"
                   FontWeight="Bold"
                   Foreground="#0F172A"/>

        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="20" Margin="0 0 0 20">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Mã điểm danh:" VerticalAlignment="Center"/>
                    <TextBox x:Name="txtMaDiemDanh" Width="150" Height="35" Margin="10 0"/>
                    <Button Content="Tạo mã" Width="100" Height="35" Click="BtnCreateCode_Click"/>
                </StackPanel>

                <Grid Margin="0 15 0 0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0 0 10 0">
                        <TextBlock Text="ID lớp"/>
                        <TextBox x:Name="txtLopId" Height="35"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0 0 10 0">
                        <TextBlock Text="ID học sinh"/>
                        <TextBox x:Name="txtHocSinhId" Height="35"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="0 0 10 0">
                        <TextBlock Text="Buổi học"/>
                        <ComboBox x:Name="cbBuoiHoc" Height="35">
                            <ComboBoxItem Content="sang"/>
                            <ComboBoxItem Content="chieu"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="3">
                        <TextBlock Text="Trạng thái"/>
                        <ComboBox x:Name="cbTrangThai" Height="35">
                            <ComboBoxItem Content="co_mat"/>
                            <ComboBoxItem Content="vang_co_phep"/>
                            <ComboBoxItem Content="vang_khong_phep"/>
                            <ComboBoxItem Content="di_muon"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <TextBox x:Name="txtGhiChu" Height="35" Margin="0 15 0 0"/>

                <Button Content="Lưu điểm danh"
                        Width="140"
                        Height="38"
                        Margin="0 15 0 0"
                        Background="#2563EB"
                        Foreground="White"
                        Click="BtnSave_Click"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="White" CornerRadius="12" Padding="20">
            <DataGrid x:Name="dgAttendance" AutoGenerateColumns="False" CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                    <DataGridTextColumn Header="Lớp" Binding="{Binding TenLop}" Width="120"/>
                    <DataGridTextColumn Header="Mã HS" Binding="{Binding MaHS}" Width="120"/>
                    <DataGridTextColumn Header="Họ tên" Binding="{Binding HoTen}" Width="180"/>
                    <DataGridTextColumn Header="Ngày" Binding="{Binding NgayDiemDanh}" Width="140"/>
                    <DataGridTextColumn Header="Buổi" Binding="{Binding BuoiHoc}" Width="100"/>
                    <DataGridTextColumn Header="Trạng thái" Binding="{Binding TrangThai}" Width="150"/>
                    <DataGridTextColumn Header="Ghi chú" Binding="{Binding GhiChu}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Page>
