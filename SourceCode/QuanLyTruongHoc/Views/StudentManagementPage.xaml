<Page x:Class="QuanLyTruongHoc.Views.StudentManagementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F4F6F8">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Quản lý học sinh"
                   FontSize="28"
                   FontWeight="Bold"
                   Foreground="#0F172A"
                   VerticalAlignment="Center"/>

        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="20" Margin="0 0 0 20">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0 0 0 15">
                    <TextBox x:Name="txtSearch" Width="300" Height="35" Padding="5"/>
                    <Button Content="Tìm kiếm" Width="100" Height="35" Margin="10 0 0 0" Click="BtnSearch_Click"/>
                    <Button Content="Tải lại" Width="100" Height="35" Margin="10 0 0 0" Click="BtnReload_Click"/>
                </StackPanel>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0 0 10 0">
                        <TextBlock Text="Mã học sinh"/>
                        <TextBox x:Name="txtMaHS" Height="35" Padding="5"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0 0 10 0">
                        <TextBlock Text="Họ tên"/>
                        <TextBox x:Name="txtHoTen" Height="35" Padding="5"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Email"/>
                        <TextBox x:Name="txtEmail" Height="35" Padding="5"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0 12 0 0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0 0 10 0">
                        <TextBlock Text="Ngày sinh"/>
                        <DatePicker x:Name="dpNgaySinh" Height="35"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0 0 10 0">
                        <TextBlock Text="Giới tính"/>
                        <ComboBox x:Name="cbGioiTinh" Height="35">
                            <ComboBoxItem Content="nam"/>
                            <ComboBoxItem Content="nu"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Địa chỉ"/>
                        <TextBox x:Name="txtDiaChi" Height="35" Padding="5"/>
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0 18 0 0">

                    <Button x:Name="btnAdd"
                            Content="Thêm"
                            Width="100"
                            Height="38"
                            Background="#2563EB"
                            Foreground="White"
                            Click="BtnAdd_Click"/>

                    <Button x:Name="btnUpdate"
                            Content="Sửa"
                            Width="100"
                            Height="38"
                            Margin="10 0 0 0"
                            Background="#16A34A"
                            Foreground="White"
                            Click="BtnUpdate_Click"/>

                    <Button x:Name="btnDelete"
                            Content="Xóa"
                            Width="100"
                            Height="38"
                            Margin="10 0 0 0"
                            Background="#DC2626"
                            Foreground="White"
                            Click="BtnDelete_Click"/>

                    <Button x:Name="btnClear"
                            Content="Làm mới"
                            Width="100"
                            Height="38"
                            Margin="10 0 0 0"
                            Click="BtnClear_Click"/>

                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="White" CornerRadius="12" Padding="20">
            <DataGrid x:Name="dgStudents" AutoGenerateColumns="False" CanUserAddRows="False" SelectionChanged="DgStudents_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="100"/>
                    <DataGridTextColumn Header="User ID" Binding="{Binding UserId}" Width="100"/>
                    <DataGridTextColumn Header="Mã HS" Binding="{Binding MaHS}" Width="120"/>
                    <DataGridTextColumn Header="Họ tên" Binding="{Binding HoTen}" Width="180"/>
                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="200"/>
                    <DataGridTextColumn Header="Ngày sinh" Binding="{Binding NgaySinh}" Width="120"/>
                    <DataGridTextColumn Header="Giới tính" Binding="{Binding GioiTinh}" Width="100"/>
                    <DataGridTextColumn Header="Lớp" Binding="{Binding TenLop}" Width="120"/>
                    <DataGridTextColumn Header="Trạng thái" Binding="{Binding TrangThai}" Width="120"/>
                    <DataGridTextColumn Header="Địa chỉ" Binding="{Binding DiaChi}" Width="250"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Page>
