<Window x:Class="QuanLyTruongHoc.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đăng nhập - Quản lý trường học"
        Height="450"
        Width="760"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F1F5F9">

    <Grid>
        <Border Width="420"
                Background="White"
                CornerRadius="18"
                Padding="35"
                VerticalAlignment="Center"
                HorizontalAlignment="Center">

            <StackPanel>
                <TextBlock Text="QUẢN LÝ TRƯỜNG HỌC"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="#0F172A"
                           HorizontalAlignment="Center"
                           Margin="0 0 0 10"/>

                <TextBlock Text="Đăng nhập hệ thống"
                           FontSize="15"
                           Foreground="#64748B"
                           HorizontalAlignment="Center"
                           Margin="0 0 0 25"/>

                <TextBlock Text="Email" FontWeight="SemiBold"/>
                <TextBox x:Name="txtEmail"
                         Height="40"
                         Margin="0 5 0 15"
                         Padding="10 0"/>

                <TextBlock Text="Mật khẩu" FontWeight="SemiBold"/>
                <PasswordBox x:Name="txtPassword"
                             Height="40"
                             Margin="0 5 0 25"
                             Padding="10 0"/>

                <Button Content="Đăng nhập"
                        Height="45"
                        Background="#2563EB"
                        Foreground="White"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Click="BtnLogin_Click"/>

                <TextBlock x:Name="txtMessage"
                           Foreground="Red"
                           Margin="0 15 0 0"
                           TextAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>