<Page x:Class="QuanLyTruongHoc.Views.AttendanceHistoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F4F6F8">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Lịch sử điểm danh"
                   FontSize="28"
                   FontWeight="Bold"/>

        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="20" Margin="0 0 0 20">
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="txtSearch" Width="300" Height="35" Padding="5"/>
                <Button Content="Tìm kiếm" Width="100" Height="35" Margin="10 0 0 0" Click="BtnSearch_Click"/>
                <Button Content="Tải lại" Width="100" Height="35" Margin="10 0 0 0" Click="BtnReload_Click"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="White" CornerRadius="12" Padding="20">
            <DataGrid x:Name="dgHistory" AutoGenerateColumns="False" CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                    <DataGridTextColumn Header="Lớp" Binding="{Binding TenLop}" Width="120"/>
                    <DataGridTextColumn Header="Mã HS" Binding="{Binding MaHS}" Width="120"/>
                    <DataGridTextColumn Header="Họ tên" Binding="{Binding HoTen}" Width="180"/>
                    <DataGridTextColumn Header="Ngày" Binding="{Binding NgayDiemDanh}" Width="140"/>
                    <DataGridTextColumn Header="Buổi" Binding="{Binding BuoiHoc}" Width="100"/>
                    <DataGridTextColumn Header="Trạng thái" Binding="{Binding TrangThai}" Width="150"/>
                    <DataGridTextColumn Header="Ghi chú" Binding="{Binding GhiChu}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Page>
