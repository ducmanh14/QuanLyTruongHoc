<Page x:Class="QuanLyTruongHoc.Views.TeachingAssignmentPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F4F6F8">
    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Phân công giảng dạy" FontSize="28" FontWeight="Bold" Foreground="#0F172A"/>

        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="20" Margin="0 0 0 20">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0 0 10 0">
                        <TextBlock Text="ID lớp"/>
                        <TextBox x:Name="txtLopId" Height="35" Padding="5"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0 0 10 0">
                        <TextBlock Text="ID giáo viên"/>
                        <TextBox x:Name="txtGiaoVienId" Height="35" Padding="5"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0 0 10 0">
                        <TextBlock Text="ID môn học"/>
                        <TextBox x:Name="txtMonHocId" Height="35" Padding="5"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Margin="0 0 10 0">
                        <TextBlock Text="Học kỳ"/>
                        <TextBox x:Name="txtHocKy" Height="35" Padding="5"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Năm học"/>
                        <TextBox x:Name="txtNamHoc" Height="35" Padding="5"/>
                    </StackPanel>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0 18 0 0">
                    <Button Content="Thêm" Width="100" Height="38" Background="#2563EB" Foreground="White" Click="BtnAdd_Click"/>
                    <Button Content="Sửa" Width="100" Height="38" Margin="10 0 0 0" Background="#16A34A" Foreground="White" Click="BtnUpdate_Click"/>
                    <Button Content="Xóa" Width="100" Height="38" Margin="10 0 0 0" Background="#DC2626" Foreground="White" Click="BtnDelete_Click"/>
                    <Button Content="Làm mới" Width="100" Height="38" Margin="10 0 0 0" Click="BtnClear_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="White" CornerRadius="12" Padding="20">
            <DataGrid x:Name="dgAssignments" AutoGenerateColumns="False" CanUserAddRows="False" SelectionChanged="DgAssignments_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                    <DataGridTextColumn Header="Lớp ID" Binding="{Binding LopId}" Width="80"/>
                    <DataGridTextColumn Header="Tên lớp" Binding="{Binding TenLop}" Width="130"/>
                    <DataGridTextColumn Header="GV ID" Binding="{Binding GiaoVienId}" Width="80"/>
                    <DataGridTextColumn Header="Giáo viên" Binding="{Binding TenGiaoVien}" Width="180"/>
                    <DataGridTextColumn Header="Môn ID" Binding="{Binding MonHocId}" Width="80"/>
                    <DataGridTextColumn Header="Môn học" Binding="{Binding TenMon}" Width="160"/>
                    <DataGridTextColumn Header="Học kỳ" Binding="{Binding HocKy}" Width="90"/>
                    <DataGridTextColumn Header="Năm học" Binding="{Binding NamHoc}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Page>