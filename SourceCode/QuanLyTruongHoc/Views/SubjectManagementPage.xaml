<Page x:Class="QuanLyTruongHoc.Views.SubjectManagementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F4F6F8">
    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Quản lý môn học" FontSize="28" FontWeight="Bold" Foreground="#0F172A"/>

        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="20" Margin="0 0 0 20">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0 0 10 0">
                        <TextBlock Text="Mã môn"/>
                        <TextBox x:Name="txtMaMon" Height="35"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0 0 10 0">
                        <TextBlock Text="Tên môn"/>
                        <TextBox x:Name="txtTenMon" Height="35"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Số tiết"/>
                        <TextBox x:Name="txtSoTiet" Height="35"/>
                    </StackPanel>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0 18 0 0">
                    <Button Content="Thêm" Width="100" Height="38" Background="#2563EB" Foreground="White" Click="BtnAdd_Click"/>
                    <Button Content="Sửa" Width="100" Height="38" Margin="10 0 0 0" Background="#16A34A" Foreground="White" Click="BtnUpdate_Click"/>
                    <Button Content="Xóa" Width="100" Height="38" Margin="10 0 0 0" Background="#DC2626" Foreground="White" Click="BtnDelete_Click"/>
                    <Button Content="Làm mới" Width="100" Height="38" Margin="10 0 0 0" Click="BtnClear_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="White" CornerRadius="12" Padding="20">
            <DataGrid x:Name="dgSubjects" AutoGenerateColumns="False" CanUserAddRows="False" SelectionChanged="DgSubjects_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="70"/>
                    <DataGridTextColumn Header="Mã môn" Binding="{Binding MaMon}" Width="150"/>
                    <DataGridTextColumn Header="Tên môn" Binding="{Binding TenMon}" Width="250"/>
                    <DataGridTextColumn Header="Số tiết" Binding="{Binding SoTiet}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Page>