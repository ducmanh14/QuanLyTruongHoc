<Page x:Class="QuanLyTruongHoc.Views.TeacherManagementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F4F6F8">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Quản lý giáo viên" 
                   FontSize="26" 
                   FontWeight="Bold" 
                   Foreground="#0F172A"
                   VerticalAlignment="Center"/>

        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="20" Margin="0 0 0 15">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0 0 0 15">
                    <TextBox x:Name="txtSearch" Width="300" Height="35" Padding="5" VerticalContentAlignment="Center"/>
                    <Button Content="Tìm kiếm" Width="100" Height="35" Margin="10 0 0 0" Click="BtnSearch_Click"/>
                    <Button Content="Tải lại" Width="100" Height="35" Margin="10 0 0 0" Click="BtnReload_Click"/>
                </StackPanel>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0 0 10 10">
                        <TextBlock Text="Mã giáo viên" Margin="0 0 0 4" Foreground="#475569"/>
                        <TextBox x:Name="txtMaGV" Height="32" VerticalContentAlignment="Center" Padding="5"/>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0 0 10 10">
                        <TextBlock Text="Họ tên" Margin="0 0 0 4" Foreground="#475569"/>
                        <TextBox x:Name="txtHoTen" Height="32" VerticalContentAlignment="Center" Padding="5"/>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="0 0 0 10">
                        <TextBlock Text="Email" Margin="0 0 0 4" Foreground="#475569"/>
                        <TextBox x:Name="txtEmail" Height="32" VerticalContentAlignment="Center" Padding="5"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0 0 10 0">
                        <TextBlock Text="Chuyên môn" Margin="0 0 0 4" Foreground="#475569"/>
                        <TextBox x:Name="txtChuyenMon" Height="32" VerticalContentAlignment="Center" Padding="5"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0 0 10 0">
                        <TextBlock Text="Số điện thoại" Margin="0 0 0 4" Foreground="#475569"/>
                        <TextBox x:Name="txtSoDienThoai" Height="32" VerticalContentAlignment="Center" Padding="5"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="5 0 0 0">
                        <Button Content="Thêm" Width="80" Height="32" Background="#2563EB" Foreground="White" FontWeight="SemiBold" Click="BtnAdd_Click"/>
                        <Button Content="Sửa" Width="80" Height="32" Margin="8 0 0 0" Background="#16A34A" Foreground="White" FontWeight="SemiBold" Click="BtnUpdate_Click"/>
                        <Button Content="Xóa" Width="80" Height="32" Margin="8 0 0 0" Background="#DC2626" Foreground="White" FontWeight="SemiBold" Click="BtnDelete_Click"/>
                        <Button Content="Làm mới" Width="85" Height="32" Margin="8 0 0 0" Click="BtnClear_Click"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="White" CornerRadius="12" Padding="15">
            <DataGrid x:Name="dgTeachers" 
                      AutoGenerateColumns="False" 
                      CanUserAddRows="False" 
                      IsReadOnly="True"
                      SelectionChanged="DgTeachers_SelectionChanged"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      MaxHeight="320"
                      RowHeight="35"
                      GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                    <DataGridTextColumn Header="User ID" Binding="{Binding UserId}" Width="70"/>
                    <DataGridTextColumn Header="Mã GV" Binding="{Binding MaGV}" Width="100"/>
                    <DataGridTextColumn Header="Họ tên" Binding="{Binding HoTen}" Width="1.5*"/>
                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="2*"/>
                    <DataGridTextColumn Header="Chuyên môn" Binding="{Binding ChuyenMon}" Width="120"/>
                    <DataGridTextColumn Header="SĐT" Binding="{Binding SoDienThoai}" Width="110"/>
                    <DataGridTextColumn Header="Ngày tạo" Binding="{Binding NgayTao, StringFormat=dd/MM/yyyy}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Page>